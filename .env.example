# ─── Supabase ────────────────────────────────────────────────────────────────
# Two credentials only. Project Settings -> API.
# The URL and anon key are safe in the browser; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses RLS entirely — never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Sifalo Pay ──────────────────────────────────────────────────────────────
# The two credentials Sifalo issues (Business -> Merchant -> API).
SIFALO_API_USER=
SIFALO_API_KEY=

# Optional. Defaults to Sifalo's live gateway; only set this to point at a sandbox.
SIFALO_API_BASE_URL=https://api.sifalopay.com/gateway/

# Sifalo has NO webhooks — the charge API is synchronous — so there is no signing
# secret to configure and no callback URL to register.

# ─── Reconciliation cron ─────────────────────────────────────────────────────
# POST /api/cron/reconcile-donations with: Authorization: Bearer <this>
CRON_SECRET=
