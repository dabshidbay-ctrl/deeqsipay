# ─── Sifalo Pay ──────────────────────────────────────────────────────────────
# The two credentials Sifalo issues, from pay.sifalo.com -> Business -> Merchant -> API.
# NEVER put real values in this file — it is committed to git. Real values go in
# .env.local, which is gitignored.
SIFALO_API_USER=
SIFALO_API_KEY=

# Optional. Defaults to Sifalo's live gateway; only set this to point at a sandbox.
SIFALO_API_BASE_URL=https://api.sifalopay.com/gateway/

# Sifalo has NO webhooks — the charge API is synchronous — so there is no signing
# secret to configure and no callback URL to register.

# ─── Reconciliation cron ─────────────────────────────────────────────────────
# POST /api/cron/reconcile-donations with: Authorization: Bearer <this>
CRON_SECRET=
