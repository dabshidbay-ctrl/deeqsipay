# ─── Supabase ────────────────────────────────────────────────────────────────
# Two credentials only. Project Settings -> API.
# The URL and anon key are safe in the browser; RLS is what protects the data.
# As everywhere in this file: placeholders only. Real values go in .env.local (gitignored)
# and in the Vercel project's environment variables.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses RLS entirely — never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Sifalo Pay ──────────────────────────────────────────────────────────────
# The two credentials Sifalo issues, from pay.sifalo.com -> Business -> Merchant -> API.
# NEVER put real values in this file — it is committed to git. Real values go in
# .env.local, which is gitignored.
SIFALO_API_USER=
SIFALO_API_KEY=

# ─── Resend (email notifications) ────────────────────────────────────────────
# API key from resend.com/api-keys. NOTIFICATION_EMAIL is where review/payout alerts go.
RESEND_API_KEY=
NOTIFICATION_EMAIL=admin@deeqsipay.com

# Native in-app checkout (donor enters number here, gets a USSD PIN prompt) instead of
# redirecting to Sifalo's hosted page. Verified: this account is NOT provisioned for it —
# every direct-charge gateway returns an empty body. Ask Sifalo to enable direct API
# charging, then set this to true. Leave unset until they confirm.
SIFALO_DIRECT_CHARGE=false

# Optional. Defaults to Sifalo's live gateway; only set this to point at a sandbox.
SIFALO_API_BASE_URL=https://api.sifalopay.com/gateway/

# Sifalo has NO webhooks — the charge API is synchronous — so there is no signing
# secret to configure and no callback URL to register.

# ─── Reconciliation cron ─────────────────────────────────────────────────────
# Scheduled in vercel.json (every 15 minutes). Vercel attaches
# `Authorization: Bearer $CRON_SECRET` to its GET automatically once this is set in the
# project's environment variables — so set it there, not only here.
#
# To run it by hand:
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" https://<host>/api/cron/reconcile-donations
#
# The job CANNOT confirm payments (Sifalo has no status lookup). It ages out stale
# unknowns and reports what still needs a human. See docs/payout-runbook.md.
CRON_SECRET=

# ─── Error monitoring (optional) ─────────────────────────────────────────────
# Leave blank and the Sentry SDK stays inert — it is optional, not a hard dependency.
# Events are scrubbed before they leave the process (lib/sentry-scrub.ts): no request
# bodies, no phone numbers, no identity-document paths, no tokens.
NEXT_PUBLIC_SENTRY_DSN=

# Build-time only, for uploading source maps. Not needed to run the app.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
