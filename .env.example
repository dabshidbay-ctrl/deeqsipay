# Supabase — server only, never expose the service role key to the browser
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — browser client (@supabase/ssr)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sifalo Pay (mobile money)
SIFALO_API_BASE_URL=https://api.sifalo.example
SIFALO_API_KEY=
# HMAC-SHA256 shared secret used to verify the x-sifalo-signature header
SIFALO_WEBHOOK_SECRET=
