# ─── Supabase ────────────────────────────────────────────────────────────────
# Two credentials only. Project Settings -> API.
# The URL and anon key are safe in the browser; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses RLS entirely — never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Sifalo Pay ──────────────────────────────────────────────────────────────
SIFALO_API_BASE_URL=https://api.sifalo.example
SIFALO_USERNAME=
SIFALO_API_KEY=

# OPTIONAL, but strongly preferred. If Sifalo gives you a webhook signing secret,
# put it here and callbacks are verified by HMAC-SHA256.
# If you LEAVE THIS BLANK, the webhook treats every callback as untrusted and
# confirms the payment against Sifalo's API before crediting anything. That is
# safe, just slower (one extra API call per callback).
SIFALO_WEBHOOK_SECRET=

# ─── Reconciliation cron ─────────────────────────────────────────────────────
# POST /api/cron/reconcile-donations with: Authorization: Bearer <this>
CRON_SECRET=
